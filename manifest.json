{
	"manifest_version": 3,
	"name": "Tab Always Alive",
	"version": "3.0.0",
	"description": "Local layered session keeper with generic session diagnostics and multiple keepalive strategies.",
	"incognito": "split",
	"permissions": ["alarms", "cookies", "debugger", "power", "scripting", "storage", "tabs"],
	"host_permissions": ["http://*/*", "https://*/*"],
	"icons": {
		"16": "icons/on-16.png",
		"32": "icons/on-32.png",
		"48": "icons/on-48.png",
		"128": "icons/on-128.png"
	},
	"background": {
		"service_worker": "service-worker.js"
	},
	"action": {
		"default_title": "Tab Always Alive",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/off-16.png",
			"32": "icons/off-32.png"
		}
	}
}
